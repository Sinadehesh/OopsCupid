generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Lead {
  id              String   @id @default(cuid())
  email           String   @unique
  quizType        String
  rawAnswers      Json?
  profileData     Json?
  coachingClaimed Boolean  @default(false)
  createdAt       DateTime @default(now())
  premiumClicked  Boolean  @default(false)
}

model WorkbookEntry {
  id          String   @id @default(cuid())
  workbook    String
  week        Int
  day         Int
  exerciseKey String
  content     Json
  sessionId   String?
  createdAt   DateTime @default(now())
}

model Purchase {
  id               String   @id @default(cuid())
  stripeSessionId  String   @unique
  sku              String
  email            String?
  amountTotal      Int
  currency         String   @default("eur")
  status           String   @default("paid")
  /// Human-delivered offers (coaching) stay unfulfilled until a
  /// scheduling link is sent. Flip to false once delivered.
  needsScheduling  Boolean  @default(false)
  createdAt        DateTime @default(now())

  @@index([email])
  @@index([needsScheduling])
}
