# ─── Stripe (required for payments) ───────────────────────────────────
# Secret key: Stripe → Developers → API keys. NEVER commit the real value.
STRIPE_SECRET_KEY=sk_test_xxx
# Signing secret from Stripe → Developers → Webhooks → your endpoint
STRIPE_WEBHOOK_SECRET=whsec_xxx
# Signs entitlement cookies. Generate with: openssl rand -base64 32
ACCESS_TOKEN_SECRET=change-me
# Absolute origin used to build Stripe redirect URLs
NEXT_PUBLIC_SITE_URL=https://oopscupid.com

# ─── Existing ─────────────────────────────────────────────────────────
DATABASE_URL=postgres://...
OPENAI_API_KEY=sk-...
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
